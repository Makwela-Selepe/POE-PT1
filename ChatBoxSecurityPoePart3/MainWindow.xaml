<Window x:Class="CyberChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" Height="600" Width="800"
        Background="#1e1e2f">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Cybersecurity Awareness Bot"
                   Foreground="Cyan"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="10"
                   Grid.Row="0"/>

        <!-- Chat Area -->
        <ScrollViewer Grid.Row="1" Margin="20" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ChatStack" />
        </ScrollViewer>

        <!-- Input Area -->
        <DockPanel Grid.Row="2" Margin="10">
            <TextBox x:Name="UserInput"
                     Width="600"
                     Height="40"
                     FontSize="16"
                     VerticalContentAlignment="Center"
                     Background="#2e2e3e"
                     Foreground="White"
                     BorderBrush="Gray"
                     BorderThickness="1"
                     Padding="5"/>
            <Button Content="Send"
                    Width="100"
                    Height="40"
                    Margin="10,0,0,0"
                    Click="SendButton_Click"
                    Background="#444"
                    Foreground="White"
                    FontWeight="Bold"/>
        </DockPanel>
    </Grid>
</Window>
